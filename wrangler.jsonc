{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app100",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "e01f2e54-df39-43dc-8e83-31becebb6a80","database_name": "web-app100" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "c33419aa4e4741049075aae89ba76d74" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
